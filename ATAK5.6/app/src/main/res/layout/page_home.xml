<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fl_bg_root"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/fl_space_md">

        <!-- ── PLUGIN HEADER ──────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="@dimen/fl_space_md">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_launcher"
                android:contentDescription="FeatureLink icon"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FeatureLink"
                style="@style/FL.Text.Title" />

        </LinearLayout>

        <!-- ── ARCGIS ACCOUNT (collapsible card) ─────────────────────── -->
        <LinearLayout
            style="@style/FL.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/fl_space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ArcGIS Account"
                    style="@style/FL.Text.SectionHeader" />

                <ImageButton
                    android:id="@+id/collapse_account_btn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_chevron_up"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle account section"
                    android:padding="4dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/arcgis_account_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/fl_space_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/fl_space_sm">

                    <TextView
                        android:id="@+id/auth_status_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Not signed in"
                        android:textColor="@color/fl_error"
                        style="@style/FL.Text.Status" />

                    <Button
                        android:id="@+id/sso_login_btn"
                        style="@style/FL.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:text="Sign in with ArcGIS" />

                    <Button
                        android:id="@+id/logout_btn"
                        style="@style/FL.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:text="Sign Out"
                        android:layout_marginStart="@dimen/fl_space_sm"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ── FEATURE STATISTICS (card) ──────────────────────────────── -->
        <LinearLayout
            style="@style/FL.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="@dimen/fl_space_sm">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Feature Statistics"
                    style="@style/FL.Text.SectionHeader" />

                <Button
                    android:id="@+id/set_pli_endpoint_btn"
                    style="@style/FL.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set PLI Endpoint"
                    android:layout_marginEnd="@dimen/fl_space_sm"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/home_refresh_btn"
                    style="@style/FL.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refresh" />

            </LinearLayout>

            <TextView
                android:id="@+id/total_count_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Features: —"
                android:textColor="@color/fl_accent"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="@dimen/fl_space_sm" />

            <ListView
                android:id="@+id/layer_stats_list"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:divider="@color/fl_divider"
                android:dividerHeight="1dp"
                android:listSelector="@android:color/transparent" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
