<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fl_bg_root"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/fl_space_md">

        <!-- ── MY ARCGIS LAYERS (browse list — only relevant while signed in) ───────── -->
        <LinearLayout
            android:id="@+id/my_arcgis_layers_card"
            style="@style/FL.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/fl_space_md"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="My ArcGIS Layers"
                    style="@style/FL.Text.SectionHeader" />

                <Button
                    android:id="@+id/refresh_private_layers_btn"
                    style="@style/FL.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refresh"
                    android:layout_marginEnd="@dimen/fl_space_sm" />

                <ImageButton
                    android:id="@+id/collapse_private_btn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_chevron_down"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle My ArcGIS Layers section"
                    android:padding="4dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/private_layers_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/private_layers_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/fl_space_sm" />

                <!-- ── Shared with me — items shared via ArcGIS group membership, nested
                     below the owned-layers browse list, same collapse control as above. ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/fl_space_sm">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shared with me"
                        style="@style/FL.Text.SubsectionHeader" />

                    <TextView
                        android:id="@+id/shared_with_me_count_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill_count"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/fl_badge_count_text"
                        android:text="0" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/shared_with_me_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/fl_space_sm" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── PRIVATE LAYERS (on-device, not shared to Everyone — either shared to you by
             another user, or downloaded from "My ArcGIS Layers" and not public) — hidden
             entirely when empty. ─────────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/private_layers_card"
            style="@style/FL.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/fl_space_md"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Private Layers"
                        style="@style/FL.Text.SectionHeader" />

                    <TextView
                        android:id="@+id/private_layers_count_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill_count"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/fl_badge_count_text"
                        android:text="0" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/collapse_shared_private_btn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_chevron_down"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle Private Layers section"
                    android:padding="4dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/shared_private_layers_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/fl_space_sm"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/shared_private_layers_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── PUBLIC LAYERS ──────────────────────────────────────────────── -->
        <LinearLayout
            style="@style/FL.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Public Layers"
                        style="@style/FL.Text.SectionHeader" />

                    <TextView
                        android:id="@+id/public_layers_count_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill_count"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/fl_badge_count_text"
                        android:text="0" />

                </LinearLayout>

                <Button
                    android:id="@+id/open_add_layer_btn"
                    style="@style/FL.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_add"
                    android:drawablePadding="4dp"
                    android:text="Add Layer"
                    android:layout_marginEnd="@dimen/fl_space_sm" />

                <ImageButton
                    android:id="@+id/collapse_public_btn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_chevron_down"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle Public Layers section"
                    android:padding="4dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/public_layers_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/fl_space_sm"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/public_layers_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
