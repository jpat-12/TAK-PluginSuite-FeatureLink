<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fl_bg_root">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="@dimen/fl_space_md">

        <ImageButton
            android:id="@+id/account_back_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ArcGIS Account"
            style="@style/FL.Text.Title" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/fl_space_md">

        <LinearLayout
            style="@style/FL.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/auth_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Not signed in"
                android:textColor="@color/fl_error"
                style="@style/FL.Text.Status"
                android:layout_marginBottom="@dimen/fl_space_md" />

            <Button
                android:id="@+id/sso_login_btn"
                style="@style/FL.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="Sign in with ArcGIS" />

            <Button
                android:id="@+id/logout_btn"
                style="@style/FL.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="Sign Out"
                android:layout_marginTop="@dimen/fl_space_sm"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
