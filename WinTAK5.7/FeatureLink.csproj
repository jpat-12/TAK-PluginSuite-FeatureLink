<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{C8F2A3B4-D5E6-4F70-AB1C-2D3E4F5A6B7C}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>FeatureLink</RootNamespace>
    <AssemblyName>FeatureLink</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <!-- WinTAK DLLs are AMD64 — target x64; disable shared Roslyn compiler -->
  <!-- to prevent MSB3021 "user-mapped section" lock errors between builds. -->
  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- Standard .NET / WPF references -->
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <!--
    WinTAK SDK DLLs — copied from D:\Apps\ into libs\
    (libs\ is git-ignored; each developer populates from their WinTAK install)
  -->
  <ItemGroup>
    <Reference Include="TAK.Engine">
      <HintPath>libs\TAK.Engine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="WinTak.Framework">
      <HintPath>libs\WinTak.Framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="WinTak.Common">
      <HintPath>libs\WinTak.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="WinTak.CursorOnTarget">
      <HintPath>libs\WinTak.CursorOnTarget.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="WinTak.Net">
      <HintPath>libs\WinTak.Net.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- MapItem (RemoveLayerMarkers' Dispose() call) lives here -->
    <Reference Include="WinTak.Graphics">
      <HintPath>libs\WinTak.Graphics.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Prism 6.3 shipped with WinTAK 5.6 -->
    <Reference Include="Prism">
      <HintPath>libs\Prism.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Prism.Mef.Wpf">
      <HintPath>libs\Prism.Mef.Wpf.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Prism.Wpf">
      <HintPath>libs\Prism.Wpf.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- NuGet -->
  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>packages\Newtonsoft.Json.13.0.3\lib\net45\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="FeatureLinkButton.cs" />
    <Compile Include="FeatureLinkModule.cs" />
    <Compile Include="Models\ArcGisLayer.cs" />
    <Compile Include="Models\DownloadedFeature.cs" />
    <Compile Include="Models\OAuthTokens.cs" />
    <Compile Include="Models\PliSettings.cs" />
    <Compile Include="Services\ArcGisAuthService.cs" />
    <Compile Include="Services\ArcGisFeatureService.cs" />
    <Compile Include="Services\IconResolver.cs" />
    <Compile Include="Services\SettingsStore.cs" />
    <Compile Include="ViewModels\FeatureLinkDockPane.cs" />
    <Compile Include="Views\Converters.cs" />
    <Compile Include="Views\FeatureLinkView.xaml.cs">
      <DependentUpon>FeatureLinkView.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Page Include="Views\FeatureLinkView.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <!-- Packaging scripts (copied to output, not compiled) -->
  <ItemGroup>
    <Content Include="build-wpk.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="MANIFEST.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Large.png" />
    <Resource Include="Assets\Small.png" />
    <Resource Include="Assets\Account.png" />
  </ItemGroup>

  <!--
    Post-build (Debug only): copy DLL into the local WinTAK Plugins folder for live testing.
    WinTAK scans D:\Apps57\Plugins\ for DLL files at startup.
    NOTE: this points at the 5.7 install (kept separate from D:\Apps, which is the
    5.6 dev install used by ..\WinTAK5.6). Update PluginDir if your 5.7 install path differs.
  -->
  <Target Name="DeployPlugin" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug'">
    <PropertyGroup>
      <PluginDir Condition="'$(PluginDir)' == ''">$(FEATURELINK57_PLUGIN_DIR)</PluginDir>
      <PluginDir Condition="'$(PluginDir)' == ''">D:\Apps57\Plugins\</PluginDir>
    </PropertyGroup>
    <Message Condition="!Exists('$(PluginDir)')" Importance="High"
             Text="DeployPlugin skipped: '$(PluginDir)' does not exist. Set FEATURELINK57_PLUGIN_DIR to your WinTAK 5.7 Plugins folder." />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)"
          Condition="Exists('$(PluginDir)')" />
    <Copy SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFolder="$(PluginDir)"
          Condition="Exists('$(PluginDir)') AND '%(Extension)' == '.dll'" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
          DestinationFolder="$(PluginDir)"
          Condition="Exists('$(PluginDir)') AND Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

  <!--
    Post-build (Release only): produce a self-contained .wpk that can be
    installed on any WinTAK system via Plugins Manager (no SDK required).

    A .wpk is a ZIP containing:
      FeatureLink.dll   — the compiled plugin
      MANIFEST.xml       — package metadata read by WinTAK

    The package is written to bin\Release\FeatureLink-v$(WpkVersion).wpk.
    Bump WpkVersion in the PropertyGroup below when releasing a new version.
  -->
  <PropertyGroup>
    <TakSdkVersion>5.7.0.144</TakSdkVersion>
    <!-- C-17: distinct from 5.6's 2.7.0 and honest about this tree's state — it is a stale fork,
         not a port of current 5.6. See docs/remediation/wp3-wintak-57-parity.md. -->
    <WpkVersion>0.9.0-pre</WpkVersion>
    <WpkName>FeatureLink-$(WpkVersion)-$(TakSdkVersion)</WpkName>
    <WpkOut>$(OutputPath)$(WpkName).wpk</WpkOut>
    <PythonExe Condition="'$(PythonExe)' == ''">py -3</PythonExe>
  </PropertyGroup>

  <Target Name="PackageWpk" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'">

    <!-- C-18: packages FeatureLink.dll, its binding-redirect config, the icon AND every non-SDK
         dependency next to the output (Newtonsoft.Json.dll). Without the pinned assembly inside
         the package the plugin throws FileNotFoundException on its first JObject use, i.e. it
         cannot load at all on a clean WinTAK. The manifest is templated from the checked-in
         MANIFEST.xml rather than duplicated inside the script. -->
    <Exec Command="$(PythonExe) &quot;$(MSBuildProjectDirectory)\build-wpk.py&quot; $(WpkVersion) $(TakSdkVersion) &quot;$(TargetPath)&quot; &quot;$(MSBuildProjectDirectory)\Assets&quot; &quot;$(WpkOut)&quot; --manifest &quot;$(MSBuildProjectDirectory)\MANIFEST.xml&quot;" />

    <Message Text="Plugin package: $(WpkOut)" Importance="High" />
    <Warning Text="WinTAK 5.7 is a STALE FORK of an older 5.6 and is missing shipped functionality. Do not release this package. See docs/remediation/wp3-wintak-57-parity.md." />
  </Target>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
