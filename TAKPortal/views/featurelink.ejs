<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <h1>FeatureLink</h1>
  <p class="muted">
    On the device running ATAK, tap <strong>Open in ATAK</strong> to load a
    config with its styling directly into the FeatureLink plugin — no QR scan
    needed. On WinTAK (or any other device), use <strong>Download</strong> and
    import the file into the plugin manually. You're already signed in to TAK
    Portal, so no separate login is needed on the device.
  </p>

  <div class="card">
    <div id="configsMsg" class="msg"></div>
    <div id="configsLoading" class="muted">Loading...</div>
    <div id="configCards" class="fl-cards" style="display: none;"></div>
    <div id="configsEmpty" class="muted" style="display: none; margin-top: 16px;">
      No configs are available yet — check back once your admin has added some.
    </div>
  </div>
</main>

<style>
  .fl-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .fl-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .fl-card .fl-card-name { font-weight: 600; font-size: 15px; }
  .fl-card .fl-card-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: auto; padding-top: 4px; }
</style>

<script>
(function () {
  const msgEl = document.getElementById('configsMsg');
  const loadingEl = document.getElementById('configsLoading');
  const cardsEl = document.getElementById('configCards');
  const emptyEl = document.getElementById('configsEmpty');

  function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function openInAtak(id, btn) {
    const originalText = btn.textContent;
    btn.textContent = 'Loading...';
    btn.disabled = true;
    fetch('/api/featurelink/configs/' + encodeURIComponent(id) + '/download', { credentials: 'same-origin' })
      .then((r) => r.json())
      .then((config) => {
        const uri = 'featurelink://import?config=' + encodeURIComponent(JSON.stringify(config));
        window.location.href = uri;
      })
      .catch(() => { alert('Failed to load config.'); })
      .finally(() => { btn.textContent = originalText; btn.disabled = false; });
  }

  function renderCard(c) {
    const div = document.createElement('div');
    div.className = 'fl-card';
    const actions = c.hasLiveLayer
      ? '<button type="button" class="btn openAtakBtn" data-id="' + c.id + '">Open in ATAK</button>' +
        '<a class="btn" href="/api/featurelink/configs/' + encodeURIComponent(c.id) + '/download">Download</a>'
      : '<span class="muted">No live FeatureLayer configured yet</span>';
    div.innerHTML =
      '<span class="fl-card-name">' + escapeHtml(c.name) + '</span>' +
      '<span class="muted">Updated ' + (c.updatedAt ? new Date(c.updatedAt).toLocaleDateString() : '—') + '</span>' +
      '<div class="fl-card-actions">' + actions + '</div>';
    const openBtn = div.querySelector('.openAtakBtn');
    if (openBtn) openBtn.addEventListener('click', () => openInAtak(c.id, openBtn));
    return div;
  }

  fetch('/api/featurelink/configs', { credentials: 'same-origin' })
    .then((r) => r.json())
    .then((d) => {
      loadingEl.style.display = 'none';
      const configs = (d && d.configs) || [];
      if (!configs.length) {
        emptyEl.style.display = '';
        return;
      }
      configs.forEach((c) => cardsEl.appendChild(renderCard(c)));
      cardsEl.style.display = 'grid';
    })
    .catch(() => {
      loadingEl.style.display = 'none';
      msgEl.textContent = 'Failed to load configs.';
    });
})();
</script>
