<Window x:Class="FeatureLink.Views.SubLayerPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose layers" Height="440" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#FF0A0A0A" ResizeMode="CanResize" MinHeight="320" MinWidth="340">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="HeadingText" Foreground="White" FontSize="14" FontWeight="Bold"
                       TextWrapping="Wrap"/>
            <TextBlock Foreground="#FF9A9A9A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="This service contains more than one layer. Each one you choose is added separately, with its own symbology and sync schedule."/>
        </StackPanel>

        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,6">
            <TextBlock DockPanel.Dock="Left" Text="Layers" Foreground="#FF9A9A9A"
                       FontSize="11" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="None" Width="52" Padding="0,1"
                    Click="SelectNone_Click"/>
            <Button DockPanel.Dock="Right" Content="All" Width="44" Padding="0,1"
                    Margin="0,0,6,0" Click="SelectAll_Click"/>
        </DockPanel>

        <ListBox x:Name="LayerList" Grid.Row="2" Background="#FF161616"
                 BorderBrush="#FF2A2A2A"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Foreground="White" Margin="4,3"
                              Checked="Selection_Changed" Unchecked="Selection_Changed">
                        <StackPanel>
                            <TextBlock Text="{Binding Display}" Foreground="White"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Url}" Foreground="#FF7A7A7A"
                                       FontSize="10" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Cancel" Width="84" Margin="0,0,8,0" Padding="0,3" Click="Cancel_Click"/>
            <Button x:Name="AddButton" Content="Add" Width="96" Padding="0,3"
                    IsDefault="True" Click="Add_Click"/>
        </StackPanel>
    </Grid>
</Window>
