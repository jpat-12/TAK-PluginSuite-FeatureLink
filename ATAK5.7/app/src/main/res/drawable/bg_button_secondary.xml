<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/fl_bg_surface_alt" />
            <corners android:radius="@dimen/fl_radius_button" />
            <stroke android:width="1dp" android:color="@color/fl_border" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fl_bg_surface_alt" />
            <corners android:radius="@dimen/fl_radius_button" />
            <stroke android:width="1dp" android:color="@color/fl_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/fl_radius_button" />
            <stroke android:width="1dp" android:color="@color/fl_border" />
        </shape>
    </item>
</selector>
