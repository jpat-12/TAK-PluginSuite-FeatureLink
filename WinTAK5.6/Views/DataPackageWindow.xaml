<Window x:Class="FeatureLink.Views.DataPackageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create data package" Height="560" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="#FF0A0A0A" ResizeMode="CanResize" MinHeight="460" MinWidth="520">
    <Window.Resources>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9A9A9A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ListCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="4,3,4,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Package name -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Package name" Style="{StaticResource SectionHeading}"/>
            <TextBox x:Name="NameBox" Background="#FF161616" Foreground="White"
                     BorderBrush="#FF2A2A2A" Padding="6,4" FontSize="13"
                     TextChanged="NameBox_TextChanged"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="Named automatically from the selection and the time. Edit it if you want something else."/>
        </StackPanel>

        <!-- Two selection columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Layers -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="Data to include"
                               Style="{StaticResource SectionHeading}" Margin="0"/>
                    <Button DockPanel.Dock="Right" Content="None" Width="52" Padding="0,1"
                            Click="SelectNoLayers_Click"/>
                    <Button DockPanel.Dock="Right" Content="All" Width="44" Padding="0,1"
                            Margin="0,0,6,0" Click="SelectAllLayers_Click"/>
                </DockPanel>
                <ListBox x:Name="LayerList" Grid.Row="1" Background="#FF161616"
                         BorderBrush="#FF2A2A2A" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Style="{StaticResource ListCheckBox}"
                                      Checked="Selection_Changed" Unchecked="Selection_Changed">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="White"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="#FF8A8A8A"
                                               FontSize="10" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Contacts -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="Send to"
                               Style="{StaticResource SectionHeading}" Margin="0"/>
                    <Button DockPanel.Dock="Right" Content="None" Width="52" Padding="0,1"
                            Click="SelectNoContacts_Click"/>
                    <Button DockPanel.Dock="Right" Content="All" Width="44" Padding="0,1"
                            Margin="0,0,6,0" Click="SelectAllContacts_Click"/>
                </DockPanel>
                <ListBox x:Name="ContactList" Grid.Row="1" Background="#FF161616"
                         BorderBrush="#FF2A2A2A" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Content="{Binding Name}"
                                      Style="{StaticResource ListCheckBox}"
                                      Checked="Selection_Changed" Unchecked="Selection_Changed"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoContactsNote" Grid.Row="1" Style="{StaticResource Hint}"
                           Margin="8" VerticalAlignment="Top" Visibility="Collapsed"
                           Text="No contacts are reachable. You can still save the package to a file."/>
            </Grid>
        </Grid>

        <!-- Contents summary -->
        <Border Grid.Row="2" Background="#FF121212" BorderBrush="#FF2A2A2A" BorderThickness="1"
                Padding="8,6" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="SummaryText" Foreground="White" FontSize="12"
                           TextWrapping="Wrap" Text="Nothing selected."/>
                <TextBlock x:Name="WarningText" Foreground="#FFE0A030" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Style="{StaticResource Hint}" Margin="0,8,0,0"
                   Text="Each layer travels as its FeatureLink configuration plus any icons this machine has generated for it, so a recipient who cannot reach ArcGIS still sees the right symbols."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="Save to file…" Width="104" Margin="0,0,8,0"
                    Padding="0,3" Click="Save_Click"/>
            <Button Content="Cancel" Width="84" Margin="0,0,8,0" Padding="0,3" Click="Cancel_Click"/>
            <Button x:Name="SendButton" Content="Send" Width="84" Padding="0,3"
                    IsDefault="True" Click="Send_Click"/>
        </StackPanel>
    </Grid>
</Window>
