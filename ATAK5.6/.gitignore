# ── Gradle ───────────────────────────────────────────────────────────────────
.gradle/
build/
app/build/
gradle.properties

# ── Android ──────────────────────────────────────────────────────────────────
local.properties
*.apk
*.aab
*.dex
*.class
out/
gen/
captures/
proguard/

# ── Signing keys ─────────────────────────────────────────────────────────────
*.jks
*.keystore

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo

# ── Logs / profiling ─────────────────────────────────────────────────────────
*.log
*.hprof

# ── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini

# ── Keep these SDK support files — required by the build ─────────────────────
!.takdev/
!.takdev/aars/
!.takdev/aars/*.aar
!buildtools/
!buildtools/atak-gradle-takdev.jar
!app/featurelink.keystore

# gradle.properties is ignored above (may carry machine-specific paths/secrets elsewhere),
# except this one — it only sets a JVM heap size for R8, needed on any CI runner since a
# civRelease build's minification pass has hit OutOfMemoryError on the default heap.
!gradle.properties
