<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fl_bg_input_focused" />
            <corners android:radius="@dimen/fl_radius_input" />
            <stroke android:width="1dp" android:color="@color/fl_border_focused" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fl_bg_input" />
            <corners android:radius="@dimen/fl_radius_input" />
            <stroke android:width="1dp" android:color="@color/fl_border" />
        </shape>
    </item>
</selector>
