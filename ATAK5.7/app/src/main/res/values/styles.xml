<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Required by ATAK plugin system -->
    <style name="AppTheme" parent="android:Theme.DeviceDefault" />

    <!-- Dark ATAK-flavoured theme applied in onCreate -->
    <style name="ATAKPluginTheme" parent="android:Theme.DeviceDefault">
        <item name="android:colorBackground">@color/fl_bg_root</item>
        <item name="android:textColor">@color/fl_text_primary</item>
        <item name="android:editTextColor">@color/fl_text_primary</item>
        <item name="android:editTextBackground">@android:color/transparent</item>
    </style>

    <!-- Tab text color state list lives in drawable/tab_text_selector.xml -->

    <!-- ── Text styles ─────────────────────────────────────────────────── -->
    <style name="FL.Text.Title" parent="">
        <item name="android:textColor">@color/fl_text_primary</item>
        <item name="android:textSize">@dimen/fl_text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FL.Text.SectionHeader" parent="">
        <item name="android:textColor">@color/fl_text_primary</item>
        <item name="android:textSize">@dimen/fl_text_section</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FL.Text.Body" parent="">
        <item name="android:textColor">@color/fl_text_secondary</item>
        <item name="android:textSize">@dimen/fl_text_body</item>
    </style>

    <style name="FL.Text.Hint" parent="">
        <item name="android:textColor">@color/fl_text_muted</item>
        <item name="android:textSize">@dimen/fl_text_small</item>
    </style>

    <style name="FL.Text.Status" parent="">
        <item name="android:textColor">@color/fl_text_secondary</item>
        <item name="android:textSize">@dimen/fl_text_small</item>
    </style>

    <!-- ── Buttons ─────────────────────────────────────────────────────── -->
    <style name="FL.Button" parent="android:Widget.Material">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingLeft">@dimen/fl_space_lg</item>
        <item name="android:paddingRight">@dimen/fl_space_lg</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="FL.Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/fl_text_primary</item>
    </style>

    <style name="FL.Button.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/fl_text_secondary</item>
    </style>

    <style name="FL.Button.Small" parent="FL.Button.Secondary">
        <item name="android:textSize">11sp</item>
        <item name="android:minHeight">30dp</item>
        <item name="android:paddingLeft">@dimen/fl_space_md</item>
        <item name="android:paddingRight">@dimen/fl_space_md</item>
    </style>

    <!-- ── Inputs ──────────────────────────────────────────────────────── -->
    <style name="FL.Input" parent="">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/fl_text_primary</item>
        <item name="android:textColorHint">@color/fl_text_hint</item>
        <item name="android:textSize">@dimen/fl_text_body</item>
        <item name="android:padding">10dp</item>
    </style>

    <!-- ── Card container ──────────────────────────────────────────────── -->
    <style name="FL.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/fl_space_md</item>
    </style>

</resources>
