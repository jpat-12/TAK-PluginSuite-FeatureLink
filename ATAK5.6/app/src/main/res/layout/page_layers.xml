<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fl_bg_root"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/fl_space_md">

        <!-- ── MY ARCGIS LAYERS ───────────────────────────────────────────── -->
        <LinearLayout
            style="@style/FL.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/fl_space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="My ArcGIS Layers"
                    style="@style/FL.Text.SectionHeader" />

                <Button
                    android:id="@+id/refresh_private_layers_btn"
                    style="@style/FL.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refresh"
                    android:layout_marginEnd="@dimen/fl_space_sm" />

                <ImageButton
                    android:id="@+id/collapse_private_btn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_chevron_up"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle My ArcGIS Layers section"
                    android:padding="4dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/private_layers_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Shown when not signed in -->
                <TextView
                    android:id="@+id/layers_sign_in_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sign in on the Home tab to see your ArcGIS layers."
                    style="@style/FL.Text.Hint"
                    android:gravity="center"
                    android:paddingTop="@dimen/fl_space_lg"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/private_layers_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/fl_space_sm" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── PUBLIC LAYERS ──────────────────────────────────────────────── -->
        <LinearLayout
            style="@style/FL.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Public Layers"
                    style="@style/FL.Text.SectionHeader" />

                <Button
                    android:id="@+id/open_add_layer_btn"
                    style="@style/FL.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_add"
                    android:drawablePadding="4dp"
                    android:text="Add Layer"
                    android:layout_marginEnd="@dimen/fl_space_sm" />

                <ImageButton
                    android:id="@+id/collapse_public_btn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_chevron_up"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle Public Layers section"
                    android:padding="4dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/public_layers_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/fl_space_sm">

                <LinearLayout
                    android:id="@+id/public_layers_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
