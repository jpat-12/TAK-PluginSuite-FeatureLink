<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fl_bg_root"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/fl_space_md">

        <!-- ── FEATURE STATISTICS (collapsible card) ─────────────────── -->
        <LinearLayout
            style="@style/FL.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Feature Statistics"
                    style="@style/FL.Text.SectionHeader" />

                <Button
                    android:id="@+id/set_pli_endpoint_btn"
                    style="@style/FL.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set PLI Endpoint"
                    android:layout_marginEnd="@dimen/fl_space_sm"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/home_refresh_btn"
                    style="@style/FL.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refresh"
                    android:layout_marginEnd="@dimen/fl_space_sm" />

                <ImageButton
                    android:id="@+id/collapse_stats_btn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_chevron_up"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle statistics section"
                    android:padding="4dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/stats_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/fl_space_sm">

                <TextView
                    android:id="@+id/total_count_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Features: —"
                    android:textColor="@color/fl_accent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingBottom="@dimen/fl_space_sm" />

                <ListView
                    android:id="@+id/layer_stats_list"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:divider="@color/fl_divider"
                    android:dividerHeight="1dp"
                    android:listSelector="@android:color/transparent" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
