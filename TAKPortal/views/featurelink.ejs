<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <h1>FeatureLink</h1>
  <p class="muted">
    On the device running ATAK, tap <strong>Open in ATAK</strong> to load a
    config with its styling directly into the FeatureLink plugin — no QR scan
    needed. On WinTAK (or any other device), use <strong>Download</strong> and
    import the file into the plugin manually. You're already signed in to TAK
    Portal, so no separate login is needed on the device.
  </p>

  <div class="card">
    <div id="configsMsg" class="msg"></div>
    <div id="configsLoading" class="muted">Loading...</div>
    <div id="configCards" class="fl-cards" style="display: none;"></div>
    <div id="configsEmpty" class="muted" style="display: none; margin-top: 16px;">
      No configs are available yet — check back once your admin has added some.
    </div>
  </div>
</main>

<style>
  .fl-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .fl-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .fl-card .fl-card-name { font-weight: 600; font-size: 15px; }
  .fl-card .fl-card-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: auto; padding-top: 4px; }
  .openAtakBtn[aria-disabled="true"] { opacity: 0.5; cursor: not-allowed; pointer-events: none; }
</style>

<script>
(function () {
  const msgEl = document.getElementById('configsMsg');
  const loadingEl = document.getElementById('configsLoading');
  const cardsEl = document.getElementById('configCards');
  const emptyEl = document.getElementById('configsEmpty');

  // Why the link is a bare `featurelink://` URI rather than an `intent://` wrapper — including
  // the tak:// scheme dead end — is recorded in docs/ rather than shipped to every field user's
  // browser. (Appendix D §6: nine lines of adb experiment notes were being served on this page.)
  function buildImportUri(config) {
    return 'featurelink://import?config=' + encodeURIComponent(JSON.stringify(config));
  }

  function span(cls, text) {
    const el = document.createElement('span');
    if (cls) el.className = cls;
    el.textContent = text;
    return el;
  }

  /**
   * C-05 sweep: `c.id` was interpolated raw into `data-id="..."` inside an innerHTML string. Ids
   * are hex-only server-side today, so this was not exploitable — but it is the same
   * asserted-rather-than-enforced pattern as the confirmed XSS on the admin page, one service
   * change away from being live. Built with DOM nodes instead.
   */
  function renderCard(c) {
    const div = document.createElement('div');
    div.className = 'fl-card';

    div.appendChild(span('fl-card-name', c.name == null ? '' : String(c.name)));
    const fields = Number(c.fieldCount) || 0;
    const features = Number(c.featureCount) || 0;
    div.appendChild(span('muted', fields + ' fields · ' + features.toLocaleString() + ' features'));
    div.appendChild(span('muted', 'Updated ' + (c.updatedAt ? new Date(c.updatedAt).toLocaleDateString() : '—')));

    const actions = document.createElement('div');
    actions.className = 'fl-card-actions';
    div.appendChild(actions);

    if (!c.hasLiveLayer) {
      actions.appendChild(span('muted', 'No display styling exported yet'));
      return div;
    }

    const openLink = document.createElement('a');
    openLink.className = 'btn openAtakBtn';
    openLink.href = '#';
    openLink.setAttribute('aria-disabled', 'true');
    openLink.textContent = 'Loading...';
    openLink.dataset.id = c.id;
    openLink.addEventListener('click', (e) => {
      if (openLink.getAttribute('aria-disabled') === 'true') e.preventDefault();
    });
    actions.appendChild(openLink);

    const dl = document.createElement('a');
    dl.className = 'btn';
    dl.href = '/api/featurelink/configs/' + encodeURIComponent(c.id) + '/download';
    dl.textContent = 'Download';
    actions.appendChild(dl);

    div.__prefetch = () =>
      fetch('/api/featurelink/configs/' + encodeURIComponent(c.id) + '/download', { credentials: 'same-origin' })
        .then((r) => r.json())
        .then((config) => {
          openLink.href = buildImportUri(config);
          openLink.textContent = 'Open in ATAK';
          openLink.removeAttribute('aria-disabled');
        })
        .catch(() => { openLink.textContent = 'Failed to load'; });
    return div;
  }

  /**
   * Appendix D §4.9: this page issued ONE fetch per config on load, each returning a full exported
   * config. With 200 configs that is 200 parallel requests. Bounded to 4 in flight.
   */
  function prefetchAll(cards) {
    const queue = cards.filter((el) => typeof el.__prefetch === 'function');
    let active = 0;
    const pump = () => {
      while (active < 4 && queue.length) {
        active++;
        queue.shift().__prefetch().finally(() => { active--; pump(); });
      }
    };
    pump();
  }

  fetch('/api/featurelink/configs', { credentials: 'same-origin' })
    .then((r) => r.json())
    .then((d) => {
      loadingEl.style.display = 'none';
      const configs = (d && d.configs) || [];
      if (!configs.length) {
        emptyEl.style.display = '';
        return;
      }
      const cards = configs.map(renderCard);
      cards.forEach((el) => cardsEl.appendChild(el));
      cardsEl.style.display = 'grid';
      prefetchAll(cards);
    })
    .catch(() => {
      loadingEl.style.display = 'none';
      msgEl.textContent = 'Failed to load configs.';
    });
})();
</script>
