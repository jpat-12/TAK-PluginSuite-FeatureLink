<Window x:Class="FeatureLink.Views.ContactPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Share layer with…" Height="360" Width="320"
        WindowStartupLocation="CenterOwner"
        Background="#FF0A0A0A" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Share with…" Foreground="White" FontSize="14"
                   FontWeight="Bold" Margin="0,0,0,8"/>

        <ListBox x:Name="ContactList" Grid.Row="1" Background="#FF161616" Foreground="White"
                 BorderBrush="#FF2A2A2A" DisplayMemberPath="Name"
                 MouseDoubleClick="ContactList_MouseDoubleClick"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Share" Width="80" Click="Share_Click"/>
        </StackPanel>
    </Grid>
</Window>
